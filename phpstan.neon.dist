parameters:
    paths:
        - src/
        - config/
        - database/
        - lang/
        - resources/

    excludePaths:
        # Blade / guideline templates are not PHP classes.
        - resources/boost/**

    # 1 is the minimum, 10 the most strict.
    level: 1

    # env() belongs in a package's publishable config. Without this, Larastan
    # compares against the Testbench skeleton's config path and flags config/*.php.
    configDirectories:
        - config

    # Lets Larastan read this package's migrations so Eloquent attributes
    # (e.g. BackupMonitor::$is_active) resolve instead of property.notFound.
    databaseMigrationsPath:
        - database/migrations
